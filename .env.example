# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — never commit real API keys.

# Required for AI-generated briefs. Get a free key at https://console.groq.com/keys
# If this is unset, the app still works — it falls back to the deterministic
# template generator in src/lib/fallbackBrief.ts instead of calling the AI.
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-120b if unset.
# Groq's strict response_format: json_schema mode is currently only
# supported by the openai/gpt-oss family (gpt-oss-120b, gpt-oss-20b) — see
# https://console.groq.com/docs/structured-outputs#supported-models
GROQ_MODEL=openai/gpt-oss-120b
